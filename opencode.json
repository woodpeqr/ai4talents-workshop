{
  "$schema": "https://opencode.ai/config.json",
  "model": "class/sonnet",
  "providers": {
    "class": {
      "name": "Class",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.0.201:4000/v1",
        "apiKey": "-"
      },
      "compatibility": {
        "cacheFormat": "anthropic"
      },
      "models": {
        "haiku": {
          "name": "Haiku 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        },
        "sonnet": {
          "name": "Sonnet 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        }
      }
    }
  }
}
